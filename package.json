{
  "name": "soniox-js",
  "version": "0.0.0",
  "license": "MIT",
  "description": "Official Soniox JS monorepo",
  "private": true,
  "repository": {
    "type": "git",
    "url": "git+https://github.com/soniox/soniox-js.git"
  },
  "workspaces": [
    "packages/*",
    "examples/**"
  ],
  "scripts": {
    "build": "tsc -b --force && npm run build --workspaces --if-present",
    "clean": "tsc -b --clean && npm run clean --workspaces --if-present",
    "format": "prettier --write \"packages/*/src/**/*.ts\"",
    "format:check": "prettier --check \"packages/*/src/**/*.ts\"",
    "lint:dev": "eslint .",
    "lint": "npm run lint:dev -- --quiet",
    "test": "jest --testPathPatterns='packages/'",
    "test:integration": "jest --testPathPatterns='examples/'",
    "test:all": "jest",
    "test:coverage": "npm run test -- --coverage",
    "typecheck": "tsc -b --force",
    "docs": "npm run typecheck && typedoc --options typedoc.node.json && typedoc --options typedoc.client.json && typedoc --options typedoc.react.json && node scripts/consolidate-docs.mjs node && node scripts/consolidate-docs.mjs client && node scripts/consolidate-docs.mjs react",
    "prepare": "husky",
    "prepublishOnly": "npm run build"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.3",
    "@types/jest": "^30.0.0",
    "@types/node": "^25.9.9",
    "@types/supertest": "^6.0.3",
    "@typescript-eslint/eslint-plugin": "^8.72.1",
    "@typescript-eslint/parser": "^8.72.1",
    "dotenv": "^17.2.3",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "eslint-import-resolver-typescript": "^4.4.5",
    "eslint-plugin-import": "^2.32.0",
    "husky": "^9.1.7",
    "jest": "^30.5.2",
    "jest-environment-jsdom": "^30.5.2",
    "prettier": "^3.9.10",
    "supertest": "^7.3.1",
    "ts-jest": "^29.4.15",
    "tsdown": "^0.19.0",
    "typedoc": "^0.28.20",
    "typedoc-plugin-markdown": "^4.14.1",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.72.1"
  }
}
